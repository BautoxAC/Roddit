# Copiá este archivo con el nombre ".env" y dejá estos valores tal cual:
#   Linux / macOS / Git Bash:  cp .env.example .env
#   Windows (CMD):             copy .env.example .env
#
# Los datos de la base (usuario, clave, nombre y puerto) tienen que coincidir
# con los que figuran en docker-compose.yml.


DATABASE_URL=postgres://roddit:roddit_pass@localhost:5432/roddit
PORT=3000
